# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files（勿提交真实 `.env`；示例模板单独放行）
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Python ---
# byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# virtual environments
.venv/
venv/
ENV/
env/
.env/

# pip / tooling caches
.pip-cache/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/

# coverage / reports
.coverage
.coverage.*
coverage.xml
nosetests.xml
htmlcov/
.hypothesis/

# PyInstaller
*.manifest
*.spec

# Jupyter
.ipynb_checkpoints/

# IDEs
.idea/
.vscode/

# type check / language servers
pyrightconfig.json
.pyre/

# --- Local docs (do not commit/push) ---
# 注意：docs/_tech_graph/ 是项目架构唯一可信来源，必须提交
docs/*
!docs/_tech_graph/

# Task specs and tech graph must be tracked
!docs/tasks/
!docs/tech_graph/
!docs/_tech_graph/

!docs/text2sql/
# v2-agent SPEC（与 docs/* 例外并列；否则新文件需 git add -f）
!docs/spec/

# Harness：任务审核 reviews、invoke 快照（与工作区 harness/invokes 约定对齐）
!docs/harness/

# Rubric 演示暂存 + jsonPKmermaid 主实验协议（与 task 审核 `docs/harness/reviews` 分离）
!docs/diary/
!docs/diary/jsonPKmermaid/
!docs/_staging/
!docs/_staging/jsonPKmermaid-rubric-demo/
