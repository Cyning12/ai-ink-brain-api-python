# Langfuse · Ops Desk 观测/评测（可选 · P2-5a）
# 复制所需行到 .env · 文档：docs/ops/LANGFUSE_QUICKSTART_zh.md
# 生产默认：LANGFUSE_TRACING=false（不发 trace）

LANGFUSE_TRACING=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Japan（推荐 · 东亚）：https://jp.cloud.langfuse.com
# EU：https://cloud.langfuse.com · US：https://us.cloud.langfuse.com
# 本地 Docker：http://localhost:3000 · 见 langfuse.env.local.docker.example
LANGFUSE_BASE_URL=https://jp.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
