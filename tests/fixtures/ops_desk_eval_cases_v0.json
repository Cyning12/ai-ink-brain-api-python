    "C": "P3 ReAct / PR 深析 · 冻结至对应 task"
  },
  "setup_sql": {
    "clear_all_demos": "DELETE FROM public.ops_demo_answers WHERE demo_id IN ('D1','D2','D3','D4');",
    "clear_one": "DELETE FROM public.ops_demo_answers WHERE demo_id = :demo_id;"
  },
  "cases": [
